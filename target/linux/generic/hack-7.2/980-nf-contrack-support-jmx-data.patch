diff -urN a/include/net/netfilter/nf_conntrack.h b/include/net/netfilter/nf_conntrack.h
--- a/include/net/netfilter/nf_conntrack.h	2025-11-27 18:06:47.320384226 +0800
+++ b/include/net/netfilter/nf_conntrack.h	2025-11-27 18:00:39.169670577 +0800
@@ -72,6 +72,21 @@
 #include <net/netfilter/ipv4/nf_conntrack_ipv4.h>
 #include <net/netfilter/ipv6/nf_conntrack_ipv6.h>
 
+#define NF_JMX_MATCH_STATUS_NO_OFFLOAD 0x80000000U
+
+struct nf_jmx_data{
+	u32 mark;
+	u32 app_id;
+	u32 match_status;
+	u8 action;
+	u8 *host;
+	/* Route policy extension for multi-WAN */
+	u32 route_mark;       /* fwmark written to skb for ip rule lookup */
+	u8  route_wan_id;     /* selected WAN interface id (0 = none/unassigned) */
+	u8  route_source;     /* 0=default, 1=app, 2=domain, 3=tuple, 4=manual */
+	u32 route_wan_generation; /* guards WAN id reuse during flow teardown */
+	u8  route_counted;    /* active_conn was acquired for this flow */
+};
 struct nf_conn {
 	/* Usage count in here is 1 for hash table, 1 per skb,
 	 * plus 1 for any connection(s) we are `master' for
@@ -121,6 +128,8 @@
 	/* Extensions */
 	struct nf_ct_ext *ext;
 
+	/*FanchmWrt Data*/
+	struct nf_jmx_data jmx_data;
 	/* Storage reserved for other modules, must be the last member */
 	union nf_conntrack_proto proto;
 };
diff -urN a/net/netfilter/nf_conntrack_core.c b/net/netfilter/nf_conntrack_core.c
--- a/net/netfilter/nf_conntrack_core.c	2025-11-27 18:06:38.992416159 +0800
+++ b/net/netfilter/nf_conntrack_core.c	2025-11-27 18:01:02.597598226 +0800
@@ -1655,6 +1655,17 @@
 	/* save hash for reusing when confirming */
 	*(unsigned long *)(&ct->tuplehash[IP_CT_DIR_REPLY].hnnode.pprev) = hash;
 	ct->status = 0;
+	/* jmx data */
+	ct->jmx_data.mark = 0;
+	ct->jmx_data.app_id = 0;
+	ct->jmx_data.match_status = 0;
+	ct->jmx_data.action = 0;
+	ct->jmx_data.host = NULL;
+	ct->jmx_data.route_mark = 0;
+	ct->jmx_data.route_wan_id = 0;
+	ct->jmx_data.route_source = 0;
+	ct->jmx_data.route_wan_generation = 0;
+	ct->jmx_data.route_counted = 0;
 	WRITE_ONCE(ct->timeout, 0);
 	write_pnet(&ct->ct_net, net);
 	memset_after(ct, 0, __nfct_init_offset);
