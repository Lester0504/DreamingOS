# Dreaming OS standalone webd bridge for the nginx :80 LAN server.
# Keep this scoped so legacy LuCI paths such as /cgi-bin/luci and /luci-static stay untouched.

include /usr/share/dreamingwrt/nginx/device-images.inc;

# LAN launch discards the one-time cloud code in webd; never forward to an app.
location = /.well-known/dreamingos-cloud/launch {
	include restrict_locally;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_pass http://127.0.0.1:12518;
}

# The realtime endpoint upgrades the connection.
# Forward the hop-by-hop headers explicitly or the browser closes the socket
# before webd can send its session frame and accept subscriptions[].
location = /api/v1/realtime/ws {
	include restrict_locally;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection "upgrade";
	proxy_read_timeout 1h;
	proxy_send_timeout 1h;
	proxy_buffering off;
	proxy_pass http://127.0.0.1:12518;
}

# Terminal sessions upgrade their /ws child; keep the same authenticated webd bridge.
location ^~ /api/v1/terminal-manager/sessions {
	include restrict_locally;
	proxy_http_version 1.1;
	proxy_set_header Host $http_host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection "upgrade";
	proxy_read_timeout 1h;
	proxy_send_timeout 1h;
	proxy_buffering off;
	proxy_pass http://127.0.0.1:12518;
}

# Installed apps use this authenticated bridge for both HTTP and WebSocket.
# Keep the original Host (including a non-default port) for Origin validation.
location ^~ /api/v1/appstore/apps/ {
	include restrict_locally;
	proxy_http_version 1.1;
	proxy_set_header Host $http_host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection "upgrade";
	proxy_read_timeout 1h;
	proxy_send_timeout 1h;
	proxy_buffering off;
	proxy_pass http://127.0.0.1:12518;
}

# Docker terminal sessions use the authenticated webd WebSocket bridge.
location ^~ /api/v1/container_service/docker/terminal/sessions {
	include restrict_locally;
	proxy_http_version 1.1;
	proxy_set_header Host $http_host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection "upgrade";
	proxy_read_timeout 1h;
	proxy_send_timeout 1h;
	proxy_buffering off;
	proxy_pass http://127.0.0.1:12518;
}

location ^~ /api/v1/ {
	include restrict_locally;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_pass http://127.0.0.1:12518;
}

location ^~ /api/setup/ {
	include restrict_locally;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_pass http://127.0.0.1:12518;
}

location = /login {
	include restrict_locally;
	return 302 /login/;
}

location = /login/ {
	include restrict_locally;
	rewrite ^ /login/index.html last;
	add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
	gzip_static on;
	gzip_vary on;
}

location ^~ /login/ {
	include restrict_locally;
	alias /www/dreamingwrt/login/;
	gzip_static on;
	gzip_vary on;
	add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
}

location = /login/index.html {
	include restrict_locally;
	alias /www/dreamingwrt/login/index.html;
	gzip_static on;
	gzip_vary on;
	add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
}

location = /app {
	include restrict_locally;
	return 302 /app/;
}

location = /app/ {
	include restrict_locally;
	rewrite ^ /app/index.html last;
	add_header Cache-Control "no-cache, must-revalidate" always;
	gzip_static on;
	gzip_vary on;
}

location ^~ /app/ {
	include restrict_locally;
	alias /www/dreamingwrt/app/;
	gzip_static on;
	gzip_vary on;
	add_header Cache-Control "no-cache, must-revalidate" always;
}

location = /app/index.html {
	include restrict_locally;
	alias /www/dreamingwrt/app/index.html;
	gzip_static on;
	gzip_vary on;
	add_header Cache-Control "no-cache, must-revalidate" always;
}

location ^~ /static/ {
	include restrict_locally;
	alias /www/dreamingwrt/static/;
	if ($http_accept_encoding !~* gzip) { return 406; }
	gzip_static on;
	gzip_vary on;
	add_header Cache-Control "no-cache, must-revalidate" always;
}

location ^~ /plugins/ {
	include restrict_locally;
	alias /www/dreamingwrt/plugins/;
	if ($http_accept_encoding !~* gzip) { return 406; }
	gzip_static on;
	gzip_vary on;
	add_header Cache-Control "no-cache, must-revalidate" always;
}

location = /dynamic/menu/1.json {
	include restrict_locally;
	proxy_http_version 1.1;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_pass http://127.0.0.1:12518;
}

location ^~ /dynamic/ {
	include restrict_locally;
	alias /www/dreamingwrt/dynamic/;
	if ($http_accept_encoding !~* gzip) { return 406; }
	gzip_static on;
	gzip_vary on;
	add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
}
