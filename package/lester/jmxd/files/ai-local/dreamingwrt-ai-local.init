#!/bin/sh /etc/rc.common
# Only the lightweight manager starts with the service. Models are user-started.
START=95
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/dreamingwrt-ai-locald
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
