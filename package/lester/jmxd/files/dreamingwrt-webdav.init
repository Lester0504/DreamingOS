#!/bin/sh /etc/rc.common
# Only task-owned WebDAV instances. Never reload the administrator's nginx.
START=95
STOP=10
USE_PROCD=1
BASE=/etc/dreamingwrt/webdav
RUN=/var/run/dreamingwrt-webdav

prepare_share() {
    local dir="$1" id="${1##*/}" mode="$2" dev ino path current role
    case "$id" in dav-*) ;; *) return 1;; esac
    [ -f "$dir/binding" ] || return 1
    read -r dev ino path < "$dir/binding"
    current="$(stat -Lc '%d %i' "$path" 2>/dev/null)"
    [ "$current" = "$dev $ino" ] || return 1
    mkdir -p "$RUN/$id" || return 1
    chmod 0755 "$RUN/$id" || return 1
    for role in data auth; do
        [ -x "$dir/$role-launch" ] || return 1
        mkdir -p "$RUN/$id/$role" || return 1
        chown nobody:nogroup "$RUN/$id/$role" || return 1
        chmod 0700 "$RUN/$id/$role" || return 1
    done
}

check_generation() {
    local generation="$1" dir found=0 role id rc=0
    case "$generation" in "$BASE"/generation-*) ;; *) return 1;; esac
    [ -d "$generation" ] || return 1
    for dir in "$generation"/dav-*; do
        [ -d "$dir" ] || continue
        prepare_share "$dir" check || return 1
        found=1
    done
    [ "$found" = 1 ] || return 0
    /usr/sbin/nginx -t -c "$generation/preflight.conf" >"$RUN/preflight.log" 2>&1 || rc=1
    for dir in "$generation"/dav-*; do
        [ -d "$dir" ] || continue
        id="${dir##*/}"
        for role in data auth; do
            chown -R nobody:nogroup "$RUN/$id/$role" || return 1
        done
    done
    return "$rc"
}

start_service() {
    local generation dir id role
    [ -f "$BASE/current" ] || return 0
    generation="$(cat "$BASE/current")"
    case "$generation" in "$BASE"/generation-*) ;; *) return 1;; esac
    [ -d "$generation" ] || return 1
    for dir in "$generation"/dav-*; do
        [ -d "$dir" ] || continue
        prepare_share "$dir" start || return 1
        id="${dir##*/}"
        for role in data auth; do
        procd_open_instance "$id-$role"
        procd_set_param command "$dir/$role-launch"
        procd_set_param respawn 3600 5 3
        procd_set_param term_timeout 10
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
        done
    done
}

extra_command "check" "Validate a generated WebDAV configuration"
check() { check_generation "$1"; }
