config browser 'main'
	option enabled '0'
	option api_host ''
	option api_port '443'
	option tunnel_host ''
	option tunnel_port '443'
	option ca_path ''
	option services_key ''
	option portal_origin 'https://api-os.dreamingnet.com'

# No service is published implicitly. Both the signed cloud manifest and a local
# enabled service record are required. Device identity and App relay are separate.
