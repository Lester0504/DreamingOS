#
# DreamingOS cloud relay client configuration.
#
# Defaults are closed on purpose: remote access stays off until an operator
# sets a host and the tunnel token issued by the relay operator.
#
# host       relay hostname or IP literal (no scheme, no path)
# port       relay TLS port
# auth_token shared tunnel secret, at least 32 characters
# tls_verify keep at 1; 0 disables certificate verification and is reported
#            in the daemon status so it cannot be forgotten silently
# ca_path    optional pinned CA bundle; empty uses the system trust store
#
config relay 'service'
	option enabled '0'
	option host ''
	option port '443'
	option auth_token ''
	option tls_verify '1'
	option ca_path ''
