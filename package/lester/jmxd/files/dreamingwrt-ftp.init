#!/bin/sh /etc/rc.common
# Dedicated FTP instances only; no changes to administrator SSH or generic vsftpd.
START=95
STOP=10
USE_PROCD=1
BASE=/etc/dreamingwrt/ftp
CORE=/usr/bin/dreamingwrt-core
BINARY=/usr/libexec/dreamingwrt/vsftpd

start_service() {
    local generation
    [ -f "$BASE/current" ] || return 0
    generation="$(cat "$BASE/current")"
    case "$generation" in "$BASE"/generation-*) ;; *) return 1;; esac
    [ -f "$generation/vsftpd.conf" ] || return 1
    [ -s "$generation/allowlist" ] || return 0
    "$CORE" --file-share-ftp prepare || return 1
    procd_open_instance managed
    procd_set_param command "$CORE" --file-share-ftp launch
    procd_set_param respawn 3600 5 3
    procd_set_param term_timeout 5
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    "$CORE" --file-share-ftp cleanup
}
