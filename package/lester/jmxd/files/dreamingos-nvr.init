#!/bin/sh /etc/rc.common
# NVR owns its recorder and export processes, independently of the browser and nvrd.
START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/dreamingos-nvrd /etc/dreamingwrt/nvr.json
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 20
	procd_set_param file /etc/dreamingwrt/nvr.json
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# procd sends SIGTERM to nvrd, whose shutdown reaps only its own file workers.
# No stop hook deletes metadata, cache or any user's source/download files.
