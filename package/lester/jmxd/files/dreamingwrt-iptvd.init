#!/bin/sh /etc/rc.common
# Independent media supervisor. Stopping never removes recordings or settings.
START=96
STOP=9
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/dreamingwrt-iptvd
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 25
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
