config wifi-device 'radio0'
	option type 'mac80211'
	option phy 'phy0'
	option band '2g'
	option channel '6'
	option htmode 'HT40'
	option country 'CN'

config wifi-device 'radio1'
	option type 'mac80211'
	option phy 'phy1'
	option band '5g'
	option channel '149'
	option htmode 'VHT80'
	option country 'CN'

config wifi-iface 'phase1_2g'
	option device 'radio0'
	option mode 'ap'
	option ssid 'Phase1-2G'
	option network 'lan'
	option encryption 'sae-mixed'
	option key 'phase1-secret-2g'

config wifi-iface 'phase1_5g'
	option device 'radio1'
	option mode 'ap'
	option ssid 'Phase1-5G'
	option network 'lan'
	option encryption 'sae'
	option key 'phase1-secret-5g'
