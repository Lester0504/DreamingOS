# Merge into the BPI-R4 seed. Partition use still requires an explicit grant.
CONFIG_DREAMINGOS_DEVICE_ROLE_GATEWAY=y
# CONFIG_DREAMINGOS_DEVICE_ROLE_INHERIT is not set
# CONFIG_DREAMINGOS_DEVICE_ROLE_AP is not set
CONFIG_DREAMINGOS_DATA_STORAGE_AUTO=y
CONFIG_DREAMINGOS_STORAGE_AUTOMOUNT=y
CONFIG_DREAMINGOS_STORAGE_PRIORITY="nvme,disk,usb,sd,emmc,system"
