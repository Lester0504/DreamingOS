+static int handle_static_leases(struct ubus_context *ctx, _o_unused struct ubus_object *obj,
+		struct ubus_request_data *req, _o_unused const char *method,
+		_o_unused struct blob_attr *msg)
+{
+	struct lease_cfg *cfg;
+	void *leases;
+
+	blob_buf_init(&b, 0);
+	leases = blobmsg_open_array(&b, "leases");
+	vlist_for_each_element(&lease_cfgs, cfg, node) {
+		struct dhcpv6_lease *lease;
+		void *entry, *duids, *bindings;
+		char hostid[sizeof(cfg->hostid) * 2 + 1];
+		bool bound = false;
+
+		entry = blobmsg_open_table(&b, NULL);
+		blobmsg_add_string(&b, "name", cfg->hostname ? cfg->hostname : "");
+		snprintf(hostid, sizeof(hostid), "%" PRIx64, cfg->hostid);
+		blobmsg_add_string(&b, "hostid", hostid);
+		blobmsg_add_u32(&b, "pd_prefixlen", cfg->pd_prefix_len);
+		blobmsg_add_string(&b, "pd_interface", cfg->pd_interface ? cfg->pd_interface : "");
+		blobmsg_add_u8(&b, "pd_only", cfg->pd_only);
+		blobmsg_add_u8(&b, "configured", true);
+
+		duids = blobmsg_open_array(&b, "duids");
+		for (size_t i = 0; i < cfg->duid_count; i++) {
+			void *d = blobmsg_open_table(&b, NULL);
+			char *buf = blobmsg_alloc_string_buffer(&b, "duid", DUID_HEXSTRLEN + 1);
+			odhcpd_hexlify(buf, cfg->duids[i].id, cfg->duids[i].len);
+			blobmsg_add_string_buffer(&b);
+			if (cfg->duids[i].iaid_set)
+				blobmsg_add_u32(&b, "iaid", cfg->duids[i].iaid);
+			blobmsg_close_table(&b, d);
+		}
+		blobmsg_close_array(&b, duids);
+
+		bindings = blobmsg_open_array(&b, "bindings");
+		list_for_each_entry(lease, &cfg->dhcpv6_leases, lease_cfg_list) {
+			void *binding, *prefixes;
+			char *buf;
+
+			if (!(lease->flags & OAF_DHCPV6_PD))
+				continue;
+			binding = blobmsg_open_table(&b, NULL);
+			buf = blobmsg_alloc_string_buffer(&b, "duid", DUID_HEXSTRLEN + 1);
+			odhcpd_hexlify(buf, lease->duid, lease->duid_len);
+			blobmsg_add_string_buffer(&b);
+			blobmsg_add_u32(&b, "iaid", ntohl(lease->iaid));
+			blobmsg_add_u8(&b, "bound", lease->bound);
+			prefixes = blobmsg_open_array(&b, "prefixes");
+			odhcpd_enum_addr6(lease->iface, lease, odhcpd_time(),
+					dhcpv6_blobmsg_ia_addr, NULL);
+			blobmsg_close_array(&b, prefixes);
+			blobmsg_close_table(&b, binding);
+			bound |= lease->bound;
+		}
+		blobmsg_close_array(&b, bindings);
+		blobmsg_add_u8(&b, "bound", bound);
+		blobmsg_close_table(&b, entry);
+	}
+	blobmsg_close_array(&b, leases);
+	ubus_send_reply(ctx, req, b.head);
+
+	return 0;
+}
