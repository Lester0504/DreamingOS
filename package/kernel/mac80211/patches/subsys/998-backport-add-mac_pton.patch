--- a/backport-include/linux/etherdevice.h
+++ b/backport-include/linux/etherdevice.h
@@ -1,3 +1,33 @@
 #ifndef __BACKPORT_LINUX_ETHERDEVICE_H
 #define __BACKPORT_LINUX_ETHERDEVICE_H
+
+/*
+ * Linux 7.0+ trees (and some combinations with backports) may not provide
+ * mac_pton() in headers visible to backports. Provide a small fallback
+ * implementation for debugfs helpers and drivers that still call it.
+ */
+#include_next <linux/etherdevice.h>
+
+#include <linux/version.h>
+#include <linux/kernel.h>
+#include <linux/if_ether.h>
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7,0,0)
+static inline int mac_pton(const char *s, u8 *mac)
+{
+	unsigned int bytes[ETH_ALEN];
+	int i;
+
+	/* Parse "aa:bb:cc:dd:ee:ff" */
+	if (sscanf(s, "%2x:%2x:%2x:%2x:%2x:%2x",
+		   &bytes[0], &bytes[1], &bytes[2],
+		   &bytes[3], &bytes[4], &bytes[5]) != ETH_ALEN)
+		return 0;
+
+	for (i = 0; i < ETH_ALEN; i++)
+		mac[i] = (u8)bytes[i];
+	return 1;
+}
+#endif
+
 #endif /* __BACKPORT_LINUX_ETHERDEVICE_H */
